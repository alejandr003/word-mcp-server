# ============================================
# Word MCP Server — environment configuration
# Copy this file to .env and adjust as needed
# ============================================

# --- Security policy ---
# Directories the server may access (semicolon-separated; empty = unrestricted)
ALLOWED_DIRECTORIES=
# Allow network paths (\\server\share)
ALLOW_NETWORK_PATHS=false
# Maximum file size (bytes)
MAX_FILE_SIZE=52428800
# Maximum text length (characters)
MAX_TEXT_LENGTH=1000000
# Enable macros (forced off by default)
ALLOW_MACROS=false
# Operation timeout (milliseconds)
OPERATION_TIMEOUT_MS=30000

# --- Rate limiting ---
# Time window (milliseconds)
RATE_LIMIT_WINDOW_MS=5000
# Maximum calls per window
RATE_LIMIT_MAX_CALLS=30

# --- Watchdog ---
# Child process silence timeout (milliseconds)
WATCHDOG_TIMEOUT_MS=30000
# Watchdog health-check interval (milliseconds)
WATCHDOG_INTERVAL_MS=5000

# --- Charts ---
# Chart operation timeout (milliseconds)
CHART_OP_TIMEOUT=15000
# Chart worker idle timeout (milliseconds)
CHART_WORKER_IDLE_TIMEOUT=60000

# --- Logging ---
# Log level: fatal / error / warn / info / debug / trace
LOG_LEVEL=info
